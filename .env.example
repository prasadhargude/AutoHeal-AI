# ==============================================================================
# AutoHeal AI — Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to Git.
#
# Usage:
#   cp .env.example .env   (Linux/Mac)
#   Copy-Item .env.example .env   (PowerShell)
#
# Then edit .env with your local values.
# ==============================================================================

# --- PostgreSQL Database ---
POSTGRES_DB=autoheal
POSTGRES_USER=autoheal_user
POSTGRES_PASSWORD=CHANGE_ME_USE_A_STRONG_PASSWORD

# Host and port used by application services and Flyway to connect.
# In Docker Compose: use the service name "postgres"
# For local development: use "localhost"
DB_HOST=postgres
DB_PORT=5432

# --- API Gateway ---
# Port the gateway listens on
GATEWAY_PORT=3000

# Downstream service URLs
# In Docker Compose: use service DNS names
# For local development: use localhost
WEB_SERVICE_URL=http://web-service:8080
AI_SERVICE_URL=http://ai-service:8000

# --- Spring Boot Web Service ---
WEB_SERVICE_PORT=8080

# --- FastAPI AI Service ---
AI_SERVICE_PORT=8000

# --- Frontend ---
# Port for the containerized frontend (Nginx)
FRONTEND_PORT=80

# --- Flyway Database Migrations ---
# Constructed from the database variables above.
# Override only if you need a custom JDBC URL.
# FLYWAY_URL=jdbc:postgresql://postgres:5432/autoheal
# FLYWAY_USER=${POSTGRES_USER}
# FLYWAY_PASSWORD=${POSTGRES_PASSWORD}

# --- Observability & Telemetry Infrastructure ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
TEMPO_PORT=3200
OTEL_COLLECTOR_GRPC_PORT=4317
OTEL_COLLECTOR_HTTP_PORT=4318

